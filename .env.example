# NextAuth v5 (Auth.js)
# Generate with: openssl rand -base64 32  (or any 32+ char random string)
AUTH_SECRET=changeme-please-generate-a-real-secret

# NextAuth canonical URL (only required in production behind a proxy)
# AUTH_URL=https://julianwiley.com

# ---- OIDC providers (leave blank to disable; Credentials/dev login still works) ----

# Microsoft Entra ID (Azure AD) — register an app at https://portal.azure.com
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Use 'common' for multi-tenant, your tenant id for single-tenant, or 'consumers' for personal MSAs
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Google — register an OAuth client at https://console.cloud.google.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Dev credentials provider (only honored when NODE_ENV !== 'production') ----
DEV_LOGIN_USERNAME=julian
DEV_LOGIN_PASSWORD=letmein

# ---- Role-based access control ----
# Comma-separated email allow-lists used by lib/access.ts:classifyEmail to
# promote OIDC users to roles above the default `viewer`. Anyone NOT listed
# below gets read-only access (can see the dashboard + project rooms but not
# the blog admin or contact inbox).
ADMIN_EMAILS=julian@julianwiley.com
EDITOR_EMAILS=

# ---- App config ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Julian Wiley

# ---- Phase 3: Live cluster KPIs ----
# Prometheus base URL the dashboard's /api/metrics/kpi route hits to render
# real numbers. Inside the k3s cluster the URL is the in-cluster service
# DNS; for local dev leave it unset and the route falls back to mock data.
# Examples (cluster):
#   PROMETHEUS_URL=http://prometheus-operated.observability.svc.cluster.local:9090
#   PROMETHEUS_URL=http://prometheus-kube-prometheus-prometheus.observability.svc.cluster.local:9090
PROMETHEUS_URL=

# ---- Phase 3: Contact form forwarding ----
# Optional outbound URL the /api/contact route POSTs submissions to. Accepts
# any HTTPS endpoint that takes a JSON body { name, email, subject, message,
# receivedAt }. Common targets: a Slack/Discord webhook, the FastAPI
# management backend in rpi_kubernetes/management/, or a serverless function.
# Leave unset to keep the Phase 1 console.log behavior.
CONTACT_FORWARD_URL=
# Optional bearer token sent in Authorization: Bearer <token>
CONTACT_FORWARD_TOKEN=
